# .env.example -- what this file is for: the telephony connector's settings (see telephony/README.md and telephony/config.py).
# Copy to .env or export in deploy/env.sh. EVERY variable is optional; a value left empty or "place your ..." counts as unset.
# Never commit real keys, secrets or passwords.

# Which adapter to use (names in providers/telephony/registry.py):
#   websocket    generic client WebSocket media endpoint (implemented)
#   wavfile      offline test adapter, a WAV file is the caller (implemented)
#   twilio       Twilio Media Streams, server mode (implemented from Twilio's docs; NOT yet tested against live Twilio)
#   sip | custom_http   recognised names, transport NOT implemented yet (selecting them stops with a clear error)
#   auto         detect from TELEPHONY_ENDPOINT: ws:// wss:// -> websocket, sip: sips: -> sip. http(s):// is refused (ambiguous).
TELEPHONY_PROVIDER=

# Optional: with provider=auto, briefly contact the endpoint to check what it speaks (opt-in; see README, Smart probe).
# TELEPHONY_AUTO_PROBE=1

# Provider-specific values, read ONLY for the selected provider (for "wavfile", ENDPOINT is a path to a caller .wav file).
TELEPHONY_ENDPOINT=place your url here
TELEPHONY_API_KEY=place your key here
TELEPHONY_API_SECRET=place your secret here
TELEPHONY_USERNAME=place your username here
TELEPHONY_PASSWORD=place your password here

# Twilio only: where this process listens (keep private, put a TLS proxy in front) and the human hand-off number (E.164).
# TELEPHONY_LISTEN_HOST=127.0.0.1
# TELEPHONY_LISTEN_PORT=8200
# TELEPHONY_TRANSFER_TO=place your number here
# (Twilio: TELEPHONY_ENDPOINT = the public wss URL in your TwiML, TELEPHONY_USERNAME = Account SID, TELEPHONY_PASSWORD = Auth Token)
#
# Twilio credentials, which are two DIFFERENT pairs and are not interchangeable:
#   TELEPHONY_USERNAME  Account SID, starts "AC". TELEPHONY_PASSWORD  Auth Token. The Auth Token is the only thing that can
#                       verify the X-Twilio-Signature on an incoming call, so it is required to accept calls at all.
#   TELEPHONY_API_KEY   API Key SID, starts "SK", with TELEPHONY_API_SECRET as its secret. Authenticates the hand-off REST
#                       call in place of Account SID + Auth Token. It CANNOT verify an incoming call.
# Putting an SK... value in TELEPHONY_USERNAME (or an AC... value in TELEPHONY_API_KEY) is refused with a message saying so.
#
# DEVELOPMENT ONLY: accept incoming streams without checking X-Twilio-Signature, so a first test call can be made before the
# Auth Token is available. While this is on, anyone who learns the URL can talk to the agent and spend your Twilio balance.
# It is ignored when TELEPHONY_PASSWORD is set -- an Auth Token always means signatures are checked.
# TELEPHONY_TWILIO_ALLOW_UNVERIFIED=1
#
# Note: nothing in this repo reads a .env file; the convention is exported variables (deploy/env.sh). For Twilio, fill in and
# source deploy/telephony-twilio.env.sh, then run `python scripts/twilio_preflight.py` to see what is still missing.

# Audio format of a provider that does not declare its own (the generic websocket adapter). Confirm with the client.
# Codec: pcm_s16le | mulaw | alaw. Defaults: pcm_s16le at 16000 Hz.
# TELEPHONY_AUDIO_CODEC=pcm_s16le
# TELEPHONY_AUDIO_SAMPLE_RATE=16000

# Where main_pcm.py listens. Keep loopback/private: /ws/audio has no authentication.
VOICE_PCM_HOST=127.0.0.1
VOICE_PCM_PORT=8101

# Optional: seconds to let the agent's last words finish after it closes the socket (default 30).
# TELEPHONY_DRAIN_TIMEOUT_S=30
# Only after /ws/audio has authentication: allow a non-private agent host.
# TELEPHONY_ALLOW_REMOTE_AGENT=1
