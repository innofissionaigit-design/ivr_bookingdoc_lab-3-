# Copy to pod.env (git-ignored) and fill in from the Vast.ai instance card.
#
# VAST_PORT is the PUBLIC port mapped to container port 8080 -- the one in
# the Jupyter URL, not 8080 itself. On the instance the mapping is also
# readable as $VAST_TCP_PORT_8080.
#
# VAST_TOKEN is the token query parameter in that same Jupyter URL. It
# grants full root execution on the instance: treat it like an SSH key,
# never commit pod.env, and rotate it by restarting the instance if it
# leaks.

VAST_HOST=194.14.47.19
VAST_PORT=22174
VAST_TOKEN=replace-me

# Where the repo lives on the instance. Keep it under /workspace: that is
# Vast's DATA_DIRECTORY and the path every script in deploy/ assumes.
VAST_REMOTE_ROOT=/workspace/kolkata-care-voice-agent
